# ─── Neon Serverless PostgreSQL (paste from Vercel dashboard) ───────────────
# Used by Prisma at runtime (goes through pgBouncer connection pooler)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15

# Used by Prisma for migrations only (bypasses pgBouncer — required for DDL)
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── Firebase (get from Firebase Console > Project Settings > Service Accounts) ─
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── LM Studio (runs locally, no key needed) ─────────────────────────────────
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=mistral-7b-instruct

# ─── App config ───────────────────────────────────────────────────────────────
GEOFENCE_RADIUS_METERS=500
RECOMMENDATION_SCORE_THRESHOLD=0.3
